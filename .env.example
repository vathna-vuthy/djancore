# Django General Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-value-12345
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in docker-compose, fallback to SQLite if unset)
DATABASE_URL=postgresql://djancore:djancore_secret@localhost:5432/djancore
CONN_MAX_AGE=60

# Redis Cache / Broker Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
