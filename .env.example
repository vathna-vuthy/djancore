# Django General Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-value-12345
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# System Config Database Encryption Key (Optional; defaults to DJANGO_SECRET_KEY)
SYSTEM_CONFIG_ENCRYPTION_KEY=

# Database Configuration (PostgreSQL in docker-compose, fallback to SQLite if unset)
DATABASE_URL=postgresql://djancore:djancore_secret@localhost:5432/djancore
CONN_MAX_AGE=60

# Redis Cache / Broker Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Notification Settings (Fallback if not configured dynamically in SystemConfig)
DEFAULT_FROM_EMAIL=noreply@djancore.local
EMAIL_HOST=localhost
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# Telegram Notification Settings (Fallback if not configured dynamically in SystemConfig)
TELEGRAM_BOT_TOKEN=

